# Copy to deploy/.env and fill in (deploy/quickstart.sh does this for the demo).
# deploy/.env is gitignored: it holds the secret. Relative paths are relative to deploy/.

# Your map bank: a folder of GenBank / FASTA / SnapGene-exported maps, mounted read-only.
# On a server this is typically a read-only mount of the lab's network share.
BANK_MOUNT=../examples/bank
# Read-WRITE mount of the same folder, used only by `sync`: the add-only copy of new uploads, the two-way
# sync of My workspace with Workspaces/<user>/, and overwrites people confirmed in the app.
# Leave it unset/unmounted and uploads simply wait in the queue.
BANK_MOUNT_RW=
# Discord channel webhook for sync alerts (share unreachable / recovered / upload refused); empty = off
PLASMIDBANK_DISCORD_WEBHOOK=
# Optional mention in front of each alert, e.g. <@123456789012345678>
PLASMIDBANK_DISCORD_MENTION=

# The lab oligo list (tab-separated; same columns as examples/oligos.tab)
OLIGO_FILE=../examples/oligos.tab

# The genome browser. Genomes are uploaded on its page and kept in the `genomes` Docker volume.
# Who adds genomes and tracks: admins (one curated copy of each, the disk stays tidy) | everyone
GENOMES_UPLOADS=admins
# Largest single upload, in GB (big plant genomes: raise it, and check the disk)
GENOMES_MAX_UPLOAD_GB=50
# Optional: a folder on this server (e.g. the lab share, mounted read-only) that admins can import
# genomes from without uploading. Empty = off.
GENOMES_IMPORT_DIR=
# The demo built on first start when there are no genomes (a folder with a seed.json); the default
# is the Lotus japonicus chloroplast in examples/genome/
GENOMES_SEED=../examples/genome

# The one name people type in the browser. The bank is at /, the genome browser at /genomes/
SITE_ADDRESS=localhost
# Host ports Caddy listens on (80/443 on a server; the demo uses 8080/8443)
HTTP_PORT=8080
HTTPS_PORT=8443
# tls internal | tls /certs/cert.pem /certs/key.pem | (empty for Let's Encrypt)
TLS_DIRECTIVE=tls internal
CERT_DIR=./certs

# Accounts: local (users file + signed cookie) or header (behind an SSO login proxy)
PLASMIDBANK_AUTH=local
# Long random string, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PLASMIDBANK_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
PLASMIDBANK_SECURE_COOKIE=1
# Shared token a lab database or label printer sends (header "Authorization: Bearer <token>") to fetch label
# images from /api/qr/<text>.png and /api/code128/<text>.png. It opens those two routes only. Empty = the token is
# refused (503); a signed-in browser still gets them. Make one with the same command as the secret above.
PLASMIDBANK_LABEL_TOKEN=
