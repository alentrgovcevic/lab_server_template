# Example unit: set WorkingDirectory to your checkout and the .mount names to your share's mount points.
[Unit]
Description=Plasmid map bank: index the map bank share (the app reloads it by itself, no restart)
Requires=docker.service mnt-plasmid_map_bank.mount
After=docker.service mnt-plasmid_map_bank.mount

[Service]
Type=oneshot
WorkingDirectory=/srv/lab_server_template
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml --env-file deploy/.env run --rm scan
